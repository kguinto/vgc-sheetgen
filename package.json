{
  "name": "vgc-sheetgen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Generate Pokémon VGC team lists from Pokémon Champions screenshots",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "sheetgen": "tsx scripts/sheetgen.ts",
    "accuracy": "tsx scripts/accuracy.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0"
    }
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jpeg-js": "^0.4.4",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.90.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
